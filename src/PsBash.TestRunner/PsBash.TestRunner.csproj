<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tiered test runner (fast shared-state pass, strict rerun of failures). Runs an xUnit v2 test
    assembly in-process through xunit.runner.utility's AssemblyRunner.

    It is started the way vstest's testhost is: `dotnet exec` with the TEST assembly's
    deps.json and runtimeconfig.json, so the test assembly and everything it references (the
    PowerShell SDK above all) load in the default load context exactly as under `dotnet test`. Only this runner's own xunit.runner.utility is
    not in that deps file; Program resolves it from the runner's directory.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.runner.utility" Version="2.9.3" />
  </ItemGroup>

</Project>
