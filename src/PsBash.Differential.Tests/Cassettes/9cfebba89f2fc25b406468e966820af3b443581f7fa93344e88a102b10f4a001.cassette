==== SCRIPT ====
[ "$EPOCHSECONDS" -gt 1700000000 ] && echo secs; case "$EPOCHREALTIME" in [0-9]*.[0-9][0-9][0-9][0-9][0-9][0-9]) echo real;; *) echo "bad $EPOCHREALTIME";; esac
